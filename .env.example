# Application
LOG_LEVEL=DEBUG
HTTP_ADDRESS=0.0.0.0:8080
# Comma-separated trusted reverse proxy CIDRs. Leave empty for direct connections.
HTTP_TRUSTED_PROXIES=

# Docker Compose
# Directory on the host containing client.crt, client.key, ca.crt, and jwt_public.pem.
SECRETS_DIR=../secrets
# Must be able to read files in SECRETS_DIR, including the private client key.
APP_UID=1000
APP_GID=1000

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PROTOCOL=3

# gRPC services
# Use auth:50051 when the auth service runs in the same Docker Compose network.
# For local host auth service on Linux, use host.docker.internal:50051 and add
# extra_hosts: ["host.docker.internal:host-gateway"] to docker-compose.yml.
AUTH_GRPC_ADDR=auth:50051
AUTH_GRPC_TLS_CERT_PATH=/run/secrets/client.crt
AUTH_GRPC_TLS_KEY_PATH=/run/secrets/client.key
AUTH_GRPC_TLS_CA_PATH=/run/secrets/ca.crt
AUTH_GRPC_TLS_SERVER_NAME=auth
AUTH_GRPC_TIMEOUT_SHORT=2s
AUTH_GRPC_TIMEOUT_DEFAULT=5s
AUTH_GRPC_TIMEOUT_LONG=8s

# Public key that matches auth service JWT_PRIVATE_KEY_PATH.
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
